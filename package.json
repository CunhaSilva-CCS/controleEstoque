{
  "name": "controle-estoque",
  "version": "1.0.0",
  "description": "ERP Cortexis Tech — Módulo Controle de Estoque",
  "main": "dist-electron/main.js",
  "author": "Cortexis Tech (cortexists.com)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:web": "WEB_ONLY=true vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "electron:build:release": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "start": "electron .",
    "smoke": "tsx scripts/smoke.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icons": "python3 scripts/generate-icons.py",
    "logo:prepare": "python3 scripts/prepare-logo.py"
  },
  "dependencies": {
    "@sentry/electron": "^6.11.0",
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  }
}
