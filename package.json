{
  "name": "controle-estoque",
  "version": "1.0.0",
  "description": "ERP Cortexis Tech — Módulo Controlo de Stock",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Cortexis Tech",
    "email": "clemilton.cunha.silva@gmail.com",
    "url": "https://cortexists.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:web": "WEB_ONLY=true vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "electron:build:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64",
    "electron:build:release": "npm run build && electron-builder --config electron-builder.config.cjs --publish onTagOrDraft",
    "start": "electron .",
    "smoke": "tsx scripts/smoke.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icons": "python3 scripts/generate-icons.py",
    "logo:prepare": "python3 scripts/prepare-logo.py",
    "manual": "node scripts/generate-user-manual.mjs",
    "manual:developer": "node scripts/generate-developer-guide.mjs",
    "license:keypair": "node scripts/license-keypair.mjs",
    "license:generate": "node scripts/license-generate.mjs"
  },
  "dependencies": {
    "@sentry/electron": "^7.17.0",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.11"
  }
}
